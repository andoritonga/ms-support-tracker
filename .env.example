# Google Sheets Configuration
SPREADSHEET_LOGS_ID=your_activity_logs_spreadsheet_id_here
SPREADSHEET_CONFIG_ID=your_customers_config_spreadsheet_id_here
SERVICE_ACCOUNT_FILE=service-account.json

# Server Configuration
PORT=8080
HOST_PORT=8081

# Cache TTL in seconds (default: 300 seconds / 5 mins for activity logs)
CACHE_TTL_SECONDS=300

# Authentication & Session Security (Option 1: Web Login UI + Signed HttpOnly Session Cookie)
# Leave AUTH_USERNAME / AUTH_PASSWORD blank to disable auth, or set AUTH_REQUIRED=true to enforce fail-closed auth.
AUTH_REQUIRED=false
AUTH_USERNAME=
AUTH_PASSWORD=
# Optional: Multiple user accounts (comma-separated username:password pairs, e.g. ando:secret1,lead:secret2)
AUTH_USERS=
# Optional: Custom HMAC-SHA256 signing secret for session cookies (auto-derived if omitted)
AUTH_SECRET=
